      FROM ALL_TAB_COLUMNS\r

      WHERE OWNER = 'FRIOPECASBI'\r

      \    AND TABLE_NAME = 'BASE_VENDAS'\r

      \    --AND COLUMN_NAME LIKE '%NOTA%'\r

      ORDER BY COLUMN_ID;"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT\r

