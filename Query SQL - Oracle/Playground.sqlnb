cells:
  - kind: 2
    value: "WITH KIT AS (\r

      \    SELECT \r

      \        MATNR_COMP,\r

      \        CASE \r

      \            WHEN COUNT(DISTINCT MATNR) > 1 THEN MATNR_COMP\r

      \            ELSE MAX(MATNR)\r

      \        END AS MATNR\r

      \    FROM FRIOPECASBI.CALC_REL_CAD_KIT\r

      \    GROUP BY MATNR_COMP\r

      ),\r

      \r

      \r

      ULTIMA_VENDA_CENTROS AS  (\r

      \tSELECT\r

      \t\t\r

      \t\tID_MATERIAL_PEDIDO,\r

      \t\tID_CENTRO,\r

      \t\tMAX(DATA_FATURAMENTO) AS ULTIMAVENDA\r

      \t\tFROM FRIOPECASBI.BASE_VENDAS\r

      \r

      \tWHERE\r

      \t\r

      \        \r

      \ ID_TIPO_DOCUMENTO_PEDIDO = 'ZNOR'\r

      \        AND CUSTO_NF > 0\r

      \        AND ID_DEPOSITO NOT IN
      ('0005','0006','0007','0008','0010','0011','0022')\r

      \t\r

      \    GROUP BY\r

      \t\tID_MATERIAL_PEDIDO,\r

      \t\tID_CENTRO\r

      \t\r

      \ \r

      \ \r

      \t\t\r

      ),\r

      \r

      AJUSTE_ZGOV_CENTROS AS (\r

      \r

      \r

      \tSELECT \r

      \t\r

      \tA.ID_MATERIAL_PEDIDO, \r

      \tAVG(NVL(A.CUSTO_NF / NULLIF(A.QTD_FATURADA, 0), 0)) AS CUSTO_MEDIO_ZNOR,
      \r

      \tA.ID_CENTRO \r

      \t \r

      \t\r

      \tFROM FRIOPECASBI.BASE_VENDAS A INNER JOIN ULTIMA_VENDA_CENTROS B
      ON  A.ID_MATERIAL_PEDIDO = B.ID_MATERIAL_PEDIDO AND A.DATA_FATURAMENTO =
      B.ULTIMAVENDA AND A.ID_CENTRO = B.ID_CENTRO\r

      \tAND A.ID_DEPOSITO NOT IN
      ('0005','0006','0007','0008','0010','0011','0022')\r

      \tAND A.CUSTO_NF > 0\r

      \ \r

      \tGROUP BY\r

      \tA.ID_MATERIAL_PEDIDO, A.ID_CENTRO \r

      \t\r

      \t\r

      \t \r

      ),\r

      \r

      DEPARA AS (\r

      \    SELECT DISTINCT\r

      \    \r

      \        MATERIAL_SAP,\r

      \        MATERIAL_ANTIGO\r

      \t\r

      \t\t\r

      \    FROM FRIOPECASBI.MATERIAL_LEGADO\r

      \r

      \    WHERE MATERIAL_ANTIGO NOT IN ('nan')\r

      ),\r

      \r

      BASEKITS AS(\r

      SELECT DISTINCT\r

      \    A.MATNR_COMP,\r

      \    CAST(\r

      \        CASE\r

      \            WHEN B.MATERIAL_ANTIGO IS NULL\r

      \                 AND REGEXP_LIKE(TRIM(A.MATNR), '^[0-9]+$')\r

      \            THEN TO_NUMBER(TRIM(A.MATNR))\r

      \            WHEN B.MATERIAL_ANTIGO IS NOT NULL\r

      \                 AND REGEXP_LIKE(TRIM(B.MATERIAL_ANTIGO), '^[0-9]+$')\r

      \            THEN TO_NUMBER(TRIM(B.MATERIAL_ANTIGO))\r

      \        END AS INT\r

      \    ) AS MATERIAL_ANTIGO,\r

      \    A.MATNR\r

      FROM KIT A\r

      LEFT JOIN DEPARA B\r

      \    ON CASE\r

      \           WHEN REGEXP_LIKE(TRIM(A.MATNR), '^[0-9]+$')\r

      \           THEN TO_NUMBER(TRIM(A.MATNR))\r

      \       END\r

      \     = CASE\r

      \           WHEN REGEXP_LIKE(TRIM(B.MATERIAL_SAP), '^[0-9]+$')\r

      \           THEN TO_NUMBER(TRIM(B.MATERIAL_SAP))\r

      \       END\r

      ),\r

      \r

      BASE AS (\r

      \    SELECT\r

      \        EXTRACT(YEAR FROM Y.DATA_FATURAMENTO) AS ANO_FATURAMENTO,\r

      \        EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) AS MES_FATURAMENTO,\r

      \        EXTRACT(DAY FROM Y.DATA_FATURAMENTO) AS DIA_FATURAMENTO,\r

      \        'FATURAMENTO' AS TIPO_NF,\r

      \        Y.NUM_PEDIDO,\r

      \        Y.ORDER_ID,\r

      \        Y.NUM_NFE_VENDA,\r

      \        Y.REFERENCIA_CLIENTE,\r

      \        Y.ID_CENTRO,\r

      \        Y.CANAL_VENDA,\r

      \        Y.GRUPO_VENDAS,\r

      \        Y.ID_ESC_VENDAS,\r

      \        Y.ECRITORIO_VENDAS,\r

      \       \r

      \        Y.ID_TIPO_DOCUMENTO_PEDIDO,\r

      \        Y.ID_VENDEDOR_SALESFORCE,\r

      \        Y.PARCEIRO_RECEBEDOR,\r

      \        CASE WHEN Y.ID_PARCEIRO_INDICACAO IS NOT NULL THEN
      CAST(Y.ID_PARCEIRO_INDICACAO AS INT) || ' - ' || Y.PARCEIRO_INDICACAO END
      PARCEIRO_INDICACAO,\r

      \r

      \        CAST(CASE WHEN Y.MATERAL_KIT IS NULL THEN Y.ID_MATERIAL_PEDIDO
      ELSE Y.MATERAL_KIT END AS INT) AS SKU_SAP,\r

      \        CAST(Y.ID_MATERIAL_PEDIDO AS INT) AS COMPONENTE,\r

      \        CAST(CASE \r

      \            WHEN Y.ID_MATERIAL_LEGADO_KIT IS NULL THEN \r

      \                CASE WHEN Y.MATERAL_KIT IS NULL THEN\r

      \                    CASE WHEN (Y.ID_MATERIAL_LEGADO IS NULL OR
      Y.ID_MATERIAL_LEGADO = 'nan') THEN Y.ID_MATERIAL_PEDIDO\r

      \                    ELSE Y.ID_MATERIAL_LEGADO END\r

      \                ELSE Y.MATERAL_KIT END\r

      \            ELSE Y.ID_MATERIAL_LEGADO_KIT END AS INT) AS SKU_VTEX,\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT) AS MATERIAL_VTEX,\r

      \        CASE WHEN Y.NOME_KIT IS NULL THEN Y.NOME_MATERIAL_PEDIDO ELSE
      Y.NOME_KIT END AS PRODUTO,\r

      \        Y.GRUPODEMATERIAL,\r

      \        Y.MARCA,\r

      \        Y.IMPORTADO,\r

      \        Y.DEPARTAMENTO,\r

      \        Y.DESCRICAO_DO_DEPARTAMENTO,\r

      \        CASE WHEN Y.ID_DEPOSITO IN
      ('0005','0006','0007','0008','0010','0011', '0012', '0022') THEN
      'OUTLET'\r

      \            ELSE Y.DESCRICAO_DO_DEPARTAMENTO END AS DEPTO_AJUSTADO,\r

      \        Y.DIVISÃO,\r

      \        Y.SEÇÃO,\r

      \        Y.TIPO,\r

      \        CAST(Y.ID_CLIENTE AS INT) AS ID_CLIENTE,\r

      \        CAST(Y.ID_CLIENTE AS INT) || ' - ' || Y.NOME_CLIENTE AS
      NOME_CLIENTE,\r

      \        Y.CNPJ,\r

      \        Y.CPF,\r

      \        Y.TIPOPESSOA,\r

      \        Y.TEXTO_CNAE,\r

      \        Y.CNAE,\r

      \        CASE WHEN Y.SEGMENTO_SALESFORCE IS NULL THEN 'CONSUMIDOR FINAL'
      ELSE Y.SEGMENTO_SALESFORCE END AS SEGMENTO_SALESFORCE,\r

      \        TO_CHAR(Y.DATA_FATURAMENTO, 'DD/MM/YYYY') AS DATA_FATURAMENTO,\r

      \        Y.PRAZO_MEDIO_OFF,\r

      \        Y.ID_FORMA_PAGAMENTO_OFF,\r

      \        Y.UF_NF AS UF_NF,\r

      \        Y.CIDADE,\r

      \        Y.CEP,\r

      \        Y.CEP_DESTINO_NF,\r

      \        Y.ID_DEPOSITO,\r

      \        Y.TIPO_FRETE,\r

      \        Y.NOME_TRANSPORTADOR,\r

      \        Y.QTD_FATURADA,\r

      \        SUM(CASE WHEN Y.CANAL_VENDA = 'Online' THEN 0 ELSE \r

      \                            CASE WHEN Y.PRECO_TABELA_SF IS NULL THEN 0
      ELSE  \r

      \                            CASE WHEN (NVL(Y.PRECO_TABELA_SF, 0) *
      NVL(Y.QTD_FATURADA, 0)) < NVL(Y.VLVENDASEMFRETE, 0) THEN 0 ELSE \r

      \                                                (NVL(Y.PRECO_TABELA_SF,
      0) * NVL(Y.QTD_FATURADA, 0)) - NVL(Y.VLVENDASEMFRETE, 0)\r

      \                            END END END) AS DESCONTO,\r

      \        SUM(NVL(Y.VALOR_CTE_LIQUIDO, 0)) AS CTE_LIQUIDO,\r

      \        null as CTE_DEVOL,\r

      \        NULL AS CTE_PROVISIONADO_DEVOL,\r

      \        SUM(CASE WHEN Y.VALOR_CTE_LIQUIDO IS NULL THEN \r

      \                        CASE WHEN Y.ID_CENTRO IN (1005, 1013, 1017, 1023,
      1025)  AND Y.DATA_FATURAMENTO >= SYSDATE - 15  THEN \r

      \                            CASE \r

      \                                    WHEN NVL(Y.VLTOTAL_NF, 0) < 500 THEN
      0.1234 * NVL(Y.VLTOTAL_NF, 0) \r

      \                                    WHEN NVL(Y.VLTOTAL_NF, 0) < 1000 THEN
      0.0834 * NVL(Y.VLTOTAL_NF, 0) \r

      \                                    WHEN NVL(Y.VLTOTAL_NF, 0) < 1500 THEN
      0.0506 * NVL(Y.VLTOTAL_NF, 0) \r

      \                                    WHEN NVL(Y.VLTOTAL_NF, 0) < 2000 THEN
      0.0394 * NVL(Y.VLTOTAL_NF, 0) \r

      \                                    WHEN NVL(Y.VLTOTAL_NF, 0) < 10000
      THEN 0.0346 * NVL(Y.VLTOTAL_NF, 0) \r

      \                            ELSE 0.0199 * NVL(Y.VLTOTAL_NF, 0) END\r

      \                        ELSE 0 END\r

      \            ELSE 0 END) AS CTE_PROVISIONADO_FATURADO,\r

      \        SUM(NVL(Y.MARGEM_CONTRIBUICAO_SF, 0)) AS
      MARGEM_CONTRIBUICAO_SF,\r

      \        SUM(NVL((Y.MARGEM_CONTRIBUICAO_SF/100)*Y.VLTOTAL_NF,0)) AS
      MC_SF_ABS,\r

      \        \r

      \        SUM(NVL(Y.ICMS_NF, 0)) AS ICMS,\r

      \r

      \   SUM(\r

      \    CASE WHEN Y.IMPORTADO = 'Nacional' AND Y.MARCA = 'Vix' THEN
      Y.CUSTO_NF\r

      \        WHEN Y.ID_TIPO_DOCUMENTO_PEDIDO = 'ZGOV'\r

      \             AND NVL(Y.CMV_CONTABIL, 0) = 0\r

      \        THEN NVL(X.CUSTO_MEDIO_ZNOR * Y.QTD_FATURADA, 0)\r

      \        ELSE NVL(Y.CUSTO_NF, 0)\r

      \    END\r

      ) AS CUSTO,\r

      \        \r

      \        SUM(NVL(Y.CMV_CONTABIL, 0)) AS CMV_CONTABIL,\r

      \        SUM(NVL(Y.ICMS_ST_NF, 0)) AS ICMS_ST,\r

      \        SUM(NVL(Y.ICMS_PARTILHA_NF, 0)) AS PARTILHA,\r

      \        SUM(NVL(Y.PIS_NF, 0)) AS PIS,\r

      \        SUM(NVL(Y.COFINS_NF, 0)) AS COFINS,\r

      \        SUM(NVL(Y.ST_FCP_NF, 0)) AS FCP_ST,\r

      \        SUM(NVL(Y.FCP_NF, 0)) AS FCP,\r

      \        SUM(NVL(Y.BENEFÍCIOS_AJUSTADO, 0)) AS BENEFÍCIOS_AJUSTADO,\r

      \        SUM(NVL(Y.ST17_NF, 0))AS ST17, \r

      \        SUM(NVL(Y.DESPESAS_FINANCEIRAS_NF, 0)) AS DESPESAS_FINANCEIRAS,\r

      \        SUM(NVL(Y.VLVENDASEMFRETE, 0)) AS VENDASEMFRETE,\r

      \        SUM(NVL(Y.BASE_ICMS_ST, 0)) AS BASE_ICMS_ST,\r

      \        SUM(NVL(Y.MARGEM_SAP, 0)) AS MARGEM_SAP,\r

      \r

      \r

      \    SUM(CASE \r

      \t        WHEN Y.NOME_CLIENTE LIKE '%HISENSE GORENJE%' THEN 0.0 \r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0242\r

      \            WHEN Y.ID_ESC_VENDAS = 'V001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0300\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0248\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0203\r

      \            WHEN Y.ID_ESC_VENDAS = 'V002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0228\r

      \            WHEN Y.ID_ESC_VENDAS = '1012' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0230\r

      \            WHEN Y.ID_ESC_VENDAS = '1015' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0240\r

      \            WHEN Y.ID_ESC_VENDAS = '1019' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0230\r

      \            WHEN Y.ID_ESC_VENDAS = '1020' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0248\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0242\r

      \            WHEN Y.ID_ESC_VENDAS = 'V003' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) <= 2024 THEN 0.0177\r

      \            WHEN Y.ID_ESC_VENDAS = 'V005' AND  Y.NOME_CLIENTE NOT LIKE
      '%HISENSE GORENJE%' AND EXTRACT(YEAR FROM Y.DATA_FATURAMENTO) <= 2024 THEN
      0.0148\r

      \t   \r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      1  THEN 0.0201\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      2  THEN 0.0244\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      3  THEN 0.0201\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      4  THEN 0.0248\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      5  THEN 0.0282\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      6  THEN 0.0288\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      7  THEN 0.0248\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      8  THEN 0.0372\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      9  THEN 0.0346\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 10
      THEN 0.0247\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 11
      THEN 0.0299\r

      \            WHEN Y.ID_ESC_VENDAS = '1001' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 12
      THEN 0.0177\r

      \r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      1  THEN 0.0244\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      2  THEN 0.0211\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      3  THEN 0.0298\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      4  THEN 0.0238\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      5  THEN 0.0291\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      6  THEN 0.0268\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      7  THEN 0.0246\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      8  THEN 0.0385\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      9  THEN 0.0262\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 10
      THEN 0.0259\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 11
      THEN 0.0316\r

      \            WHEN Y.ID_ESC_VENDAS = '1002' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 12
      THEN 0.0203\r

      \r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      1  THEN 0.0196\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      2  THEN 0.0246\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      3  THEN 0.0313\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      4  THEN 0.0329\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      5  THEN 0.0338\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      6  THEN 0.0278\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      7  THEN 0.0292\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      8  THEN 0.0325\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      9  THEN 0.0287\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 10
      THEN 0.0281\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 11
      THEN 0.0387\r

      \            WHEN Y.ID_ESC_VENDAS = '1007' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) = 12
      THEN 0.009\r

      \r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      1  THEN 0.0275\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      2  THEN 0.0292\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      3  THEN 0.0276\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      4  THEN 0.0344\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      5  THEN 0.0341\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
      Y.DATA_FATURAMENTO) = 2025 AND EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) =
      6  THEN 0.0381\r

      \            WHEN Y.ID_ESC_VENDAS = '1009' AND EXTRACT(YEAR FROM
