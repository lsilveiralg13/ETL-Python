      EXTRACT(MONTH FROM Y.DATA_FATURAMENTO) >= 6 THEN 0.0368\r

      \            ELSE 0 END * NVL(Y.VLTOTAL_NF, 0)) AS COMISSAO_OFF,\r

      \r

      \        SUM(NVL(Y.VLTOTAL_NF, 0)) AS VLNOTA,\r

      \        SUM(NVL(Y.VLTOTAL_NF, 0) - NVL(Y.VLVENDASEMFRETE, 0)) AS FRETE,\r

      \        SUM(NVL(Y.BENEFÍCIOS_FISCAIS_NF, 0)) AS BENEFICIO,\r

      \        SUM(NVL(Y.PIS_NF, 0) + NVL(Y.ICMS_NF, 0) + NVL(Y.COFINS_NF, 0) +
      NVL(Y.ICMS_PARTILHA_NF, 0) + NVL(Y.ICMS_ST_NF, 0) + NVL(Y.ST_FCP_NF, 0) +
      NVL(Y.FCP_NF, 0) + NVL(Y.ST17_NF, 0)) AS IMPOSTOS,\r

      \        SUM(NVL(Y.VALOR_CTE_LIQUIDO, 0)) AS CTE_REAL,\r

      \        SUM(BONUSSELLOUT) AS BONUSSELLOUT,\r

      \   \r

      \        SUM(Y.PRECO_TABELA_SF+(Y.PRECO_TABELA_SF*(-1*((126-Y.PRAZO_MEDIO\
      _OFF)*(0.012/30))))) AS PTABELA_SF_AJUSTADO_UNIT,\r

      \t\t\r

      \t\tSUM(
      ((Y.PRECO_TABELA_SF+(Y.PRECO_TABELA_SF*(-1*((126-Y.PRAZO_MEDIO_OFF)*(0.01\
      2/30)))))*Y.QTD_FATURADA) - Y.VLVENDASEMFRETE) AS VLDESCONTO_COM_AJUSTE,\r

      \t\t\r

      \t\tSUM(
      (Y.PRECO_TABELA_SF+(Y.PRECO_TABELA_SF*(-1*((126-Y.PRAZO_MEDIO_OFF)*(0.012\
      /30)))))*Y.QTD_FATURADA) AS PTABELA_SF_AJUSTADO_TT,\r

      \t\t\r

      \t\tSUM( Y.PRECO_TABELA_SF  * Y.QTD_FATURADA ) AS PTABELA_SF_TT,\r

      \t\tSUM( Y.PRECO_TABELA_SF ) AS PTABELA_SF_UNIT,\r

      \t\tAVG(-1*((126-Y.PRAZO_MEDIO_OFF)*(0.012/30))) AS
      PERC_DEDUCAO_PTABELA,\r

      \t\tY.CONTRIBUINTE_ICMS,\r

      \t\tY.ID_ATIVIDADE_COMERCIAL\r

      \r

      \r

      \    FROM FRIOPECASBI.BASE_VENDAS Y\r

      \    \r

      \   \r

      \r

      \    LEFT JOIN BASEKITS KT\r

      \    ON NVL(Y.ID_MATERIAL_PEDIDO, 0) = NVL(KT.MATNR_COMP, 0)\r

      \    \r

      \    LEFT JOIN AJUSTE_ZGOV_CENTROS X ON Y.ID_MATERIAL_PEDIDO =
      X.ID_MATERIAL_PEDIDO AND Y.ID_CENTRO = X.ID_CENTRO\r

      \    \r

      \ \tWHERE y.data_faturamento >= TO_DATE(:DT_INICIO,'dd/MM/yyyy')\r

      \      AND y.data_faturamento <  TO_DATE(:DT_FIM,'dd/MM/yyyy') + 1\r

      \r

      \    GROUP BY \r

      \        EXTRACT(YEAR FROM Y.DATA_FATURAMENTO),\r

      \        EXTRACT(MONTH FROM Y.DATA_FATURAMENTO),\r

      \        EXTRACT(DAY FROM Y.DATA_FATURAMENTO),\r

      \        Y.NUM_PEDIDO,\r

      \        Y.ORDER_ID,\r

      \        Y.NUM_NFE_VENDA,\r

      \        Y.REFERENCIA_CLIENTE,\r

      \        Y.ID_CENTRO,\r

      \        Y.CANAL_VENDA,\r

      \        Y.GRUPO_VENDAS,\r

      \        Y.ID_ESC_VENDAS,\r

      \        Y.ECRITORIO_VENDAS,\r

      \        Y.ID_TIPO_DOCUMENTO_PEDIDO,\r

      \        Y.ID_VENDEDOR_SALESFORCE,\r

      \        Y.PARCEIRO_RECEBEDOR,\r

      \tY.ID_PARCEIRO_INDICACAO,\r

      \        Y.PARCEIRO_INDICACAO,\r

      \    \r

      \        CAST(CASE WHEN Y.MATERAL_KIT IS NULL THEN Y.ID_MATERIAL_PEDIDO
      ELSE Y.MATERAL_KIT END AS INT),\r

      \        CAST(Y.ID_MATERIAL_PEDIDO AS INT),\r

      \        CASE WHEN Y.NOME_KIT IS NULL THEN Y.NOME_MATERIAL_PEDIDO ELSE
      Y.NOME_KIT END,\r

      \        CAST(CASE \r

      \            WHEN Y.ID_MATERIAL_LEGADO_KIT IS NULL THEN \r

      \                CASE WHEN Y.MATERAL_KIT IS NULL THEN\r

      \                    CASE WHEN (Y.ID_MATERIAL_LEGADO IS NULL OR
      Y.ID_MATERIAL_LEGADO = 'nan') THEN Y.ID_MATERIAL_PEDIDO\r

      \                    ELSE Y.ID_MATERIAL_LEGADO END\r

      \                ELSE Y.MATERAL_KIT END\r

      \            ELSE Y.ID_MATERIAL_LEGADO_KIT END AS INT),\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT),\r

      \        Y.GRUPODEMATERIAL,\r

      \        Y.MARCA,\r

      \        Y.IMPORTADO,\r

      \        Y.DEPARTAMENTO,\r

      \        Y.DESCRICAO_DO_DEPARTAMENTO,\r

      \        CASE WHEN Y.ID_DEPOSITO IN
      ('0005','0006','0007','0008','0010','0011', '0012','0022') THEN 'OUTLET'\r

      \            ELSE Y.DESCRICAO_DO_DEPARTAMENTO END,\r

      \        Y.DIVISÃO,\r

      \        Y.SEÇÃO,\r

      \        Y.TIPO,\r

      \        CAST(Y.ID_CLIENTE AS INT),\r

      \        Y.NOME_CLIENTE,\r

      \        Y.CNPJ,\r

      \        Y.CPF,\r

      \        Y.TIPOPESSOA,\r

      \        Y.TEXTO_CNAE,\r

      \        Y.CNAE,\r

      \        CASE WHEN Y.SEGMENTO_SALESFORCE IS NULL THEN 'CONSUMIDOR FINAL'
      ELSE Y.SEGMENTO_SALESFORCE END,\r

      \        TO_CHAR(Y.DATA_FATURAMENTO, 'DD/MM/YYYY'),\r

      \        Y.PRAZO_MEDIO_OFF,\r

      \        Y.ID_FORMA_PAGAMENTO_OFF,\r

      \        Y.UF_NF,\r

      \        Y.CIDADE,\r

      \        Y.CEP,\r

      \        Y.CEP_DESTINO_NF,\r

      \        Y.ID_DEPOSITO,\r

      \        Y.TIPO_FRETE,\r

      \        Y.NOME_TRANSPORTADOR,\r

      \        Y.QTD_FATURADA,\r

      \        Y.CONTRIBUINTE_ICMS,\r

      \       \tY.ID_ATIVIDADE_COMERCIAL\r

      ),\r

      DEVOL AS (\r

      \    SELECT  \r

      \        EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      ANO_FATURAMENTO,\r

      \        EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      MES_FATURAMENTO,\r

      \        EXTRACT(DAY FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      DIA_FATURAMENTO,\r

      \        'DEVOLUCAO' AS TIPO_NF,\r

      \        H.NUM_PEDIDO_VENDA,\r

      \        H.NUM_PEDIDO AS ORDER_ID,\r

      \        NULL AS NUM_NFE_VENDA,\r

      \        NULL AS REFERENCIA_CLIENTE,\r

      \        H.ID_CENTRO,\r

      \        J.CANAL_VENDA,\r

      \        J.GRUPO_VENDAS,\r

      \        NULL AS ID_ESC_VENDAS,\r

      \        J.ECRITORIO_VENDAS,\r

      \        NULL AS ID_TIPO_DOCUMENTO_PEDIDO,\r

      \        NULL AS ID_VENDEDOR_SALESFORCE,\r

      \        NULL AS PARCEIRO_RECEBEDOR,\r

      \        CASE WHEN J.ID_PARCEIRO_INDICACAO IS NULL THEN NULL ELSE
      CAST(J.ID_PARCEIRO_INDICACAO AS INT) || ' - ' || J.PARCEIRO_INDICACAO END
      PARCEIRO_INDICACAO,\r

      \        CAST(H.ID_MATERIAL AS INT) AS SKU_SAP,\r

      \        CAST(H.ID_MATERIAL AS INT) AS COMPONENTE,\r

      \        CAST(H.ID_MATERIAL AS INT) AS SKU_VTEX,\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT) AS MATERIAL_VTEX,\r

      \        H.NOME_MATERIAL_PEDIDO AS PRODUTO,\r

      \        H.GRUPO_MERCADORIA AS GRUPODEMATERIAL,\r

      \        H.MARCA AS MARCA,\r

      \        NULL AS IMPORTADO,\r

      \        NULL AS DEPARTAMENTO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO AS DEPTO_AJUSTADO,\r

      \        H.DIVISAO AS DIVISÃO,\r

      \        H.SECAO AS SEÇÃO,\r

      \        NULL AS TIPO,\r

      \        CAST(H.ID_CLIENTE AS INT) AS ID_CLIENTE,\r

      \        CAST(H.ID_CLIENTE AS INT) || ' - ' || H.NOME_CLIENTE AS
      NOME_CLIENTE,\r

      \        NULL AS CNPJ,\r

      \        NULL AS CPF,\r

      \        H.TIPO_PESSOA AS TIPOPESSOA,\r

      \        NULL AS TEXTO_CNAE,\r

      \        NULL AS CNAE,\r

      \        NULL AS SEGMENTO_SALESFORCE,\r

      \        TO_CHAR(TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD'), 'DD/MM/YYYY') AS
      DATA_FATURAMENTO,\r

      \        NULL AS PRAZO_MEDIO_OFF,\r

      \        NULL AS ID_FORMA_PAGAMENTO_OFF,\r

      \        H.REGIO AS UF_NF,\r

      \        NULL AS CIDADE,\r

      \        NULL AS CEP,\r

      \        NULL AS CEP_DESTINO_NF,\r

      \        NULL AS ID_DEPOSITO,\r

      \        NULL AS TIPO_FRETE,\r

      \        H.NOME_TRANSPORTADOR AS NOME_TRANSPORTADOR,\r

      \         SUM(NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0))) AS QTD_FATURADA,\r

      \        NULL AS DESCONTO,\r

      \        null AS CTE_LIQUIDO,\r

      \        SUM(NVL(H.VALOR_CTE_LIQUIDO, 0)) as CTE_DEVOL,\r

      \        SUM(CASE WHEN TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD') >= SYSDATE
      - 15  THEN\r

      \            CASE\r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 500 THEN 0.2468 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 1000 THEN 0.1057 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 1500 THEN 0.0607 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 2000 THEN 0.0515 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 10000 THEN 0.0391 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            ELSE 0.0165 * NVL(H.VLTOTAL_NF, 0) END ELSE 0 END) \r

      \        AS CTE_PROVISIONADO_DEVOL,\r

      \        NULL AS CTE_PROVISIONADO_FATURADO,\r

      \        NULL AS MARGEM_CONTRIBUICAO_SF,\r

      \        NULL AS MC_SF_ABS,\r

      \        -SUM(NVL(H.ICMS_NF, 0)) AS ICMS,         \r

      -SUM(\r

      \    CASE\r

      \        WHEN J.ID_TIPO_DOCUMENTO_PEDIDO = 'ZGOV'\r

      \             AND NVL(J.CUSTO_NF, 0) = 0\r

      \        THEN\r

      \            NVL(X.CUSTO_MEDIO_ZNOR, 0)\r

      \            * (NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0)))\r

      \r

      \        ELSE\r

      \            (\r

      \                NVL(J.CUSTO_NF, 0)\r

      \                / NULLIF(NVL(J.QTD_FATURADA, 0), 0)\r

      \            ) *\r

      \           (NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0)))\r

      \            \r

      \    END\r

      ) AS CUSTO,\r

      \        NULL AS CMV_CONTABIL,\r

      \        -SUM(NVL(H.ICMS_ST_NF, 0)) AS ICMS_ST,\r

      \        -SUM(NVL(H.ICMS_PARTILHA_NF, 0)) AS PARTILHA,\r

      \        -SUM(NVL(H.PIS_NF, 0)) AS PIS,\r

      \        -SUM(NVL(H.COFINS_NF, 0)) AS COFINS,\r

      \        -SUM(NVL(H.ST_FCP_NF, 0)) AS FCP_ST,\r

      \        -SUM(NVL(H.FCP_NF, 0)) AS FCP,\r

      \        NULL AS BENEFÍCIOS_AJUSTADO,\r

      \        -SUM(NVL(H.ST17_NF, 0)) AS ST17, \r

      \        -SUM(NVL(H.DESPESAS_FINANCEIRAS_NF, 0)) AS
      DESPESAS_FINANCEIRAS,\r

      \        -SUM(NVL(H.VL_VENDA_SEM_FRETE, 0)) AS VENDASEMFRETE,\r

      \        NULL AS BASE_ICMS_ST,\r

      \        NULL AS MARGEM_SAP,\r

      \        NULL AS COMISSAO_OFF,\r

      \        -SUM(NVL(H.VLTOTAL_NF, 0)) AS VLNOTA,\r

      \        -SUM(NVL(H.VLTOTAL_NF, 0) - NVL(H.VL_VENDA_SEM_FRETE, 0)) AS
      FRETE,\r

      \        \r

      \        ----------------------------------\r

      \        -- -SUM(NVL(H.BENEFICIOS_FISCAIS_NF, 0)) AS BENEFICIO #####
      REMOVIDO POR INCONSISTENCIA.\r

      \        \r

      \        -SUM(CASE \r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2023 AND J.ID_CENTRO IN ('1005','1013','1023','1017')
      THEN  0.0264\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 1 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0281\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0337\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 3 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0274\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 4 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0267\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 5 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0296\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 6 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0212\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 7 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0267\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 8 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0465\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 9 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0349\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 10 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0331\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 11 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0318\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 12 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0332\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2025 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0185\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2026 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0196  ELSE 0 END * H.VLTOTAL_NF -- BENEFICIO FISCAL DRE CANAL / ROB CD\r

      \            --WHEN A.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0266\r

      \ \r

      \        ) AS BENEFICIO,\r

      \        -----------------------------------\r

      \        \r

      \        -SUM(NVL(H.PIS_NF, 0) + NVL(H.ICMS_NF, 0) + NVL(H.COFINS_NF, 0) +
      NVL(H.ICMS_PARTILHA_NF, 0) + NVL(H.ICMS_ST_NF, 0) + NVL(H.ST_FCP_NF, 0) +
      NVL(H.FCP_NF, 0) + NVL(H.ST17_NF, 0)) AS IMPOSTOS,\r

      \        NULL AS CTE_REAL,\r

      \        NULL AS BONUSSELLOUT,\r

      \        \r

      \r

      \        \r

      \        NULL AS PTABELA_SF_AJUSTADO_UNIT,\r

      \t\t\r

      \t\tNULL AS VLDESCONTO_COM_AJUSTE,\r

      \t\t\r

      \t\tNULL AS PTABELA_SF_AJUSTADO_TT,\r

      \t\t\r

      \t\tNULL AS PTABELA_SF_TT,\r

      \t\tNULL AS PTABELA_SF_UNIT,\r

      \t\tNULL AS PERC_DEDUCAO_PTABELA,\r

      \t\tJ.CONTRIBUINTE_ICMS,\r

      \t\tJ.ID_ATIVIDADE_COMERCIAL\r

      \r

      \    FROM FRIOPECASBI.BASE_DEVOLUCAO H\r

      \r

      \    LEFT JOIN FRIOPECASBI.BASE_VENDAS J ON H.NUM_PEDIDO_VENDA =
      J.NUM_PEDIDO AND H.ID_MATERIAL = J.ID_MATERIAL_PEDIDO\r

      \    \r

      \    LEFT JOIN AJUSTE_ZGOV_CENTROS X ON H.ID_MATERIAL =
      X.ID_MATERIAL_PEDIDO AND H.ID_CENTRO = X.ID_CENTRO\r

      \r

      \    LEFT JOIN BASEKITS KT\r

      \    ON NVL(H.ID_MATERIAL, 0) = NVL(KT.MATNR_COMP, 0)\r

      \r

      \    WHERE ESTORNO_DEV IS NULL\r

      \    AND (MOTIVO_DEVOLUCAO <> 'GARANTIA' OR MOTIVO_DEVOLUCAO IS NULL)\r

      \    AND TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD') >=
      TO_DATE(:DT_INICIO,'dd/MM/yyyy')\r

      \    AND TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')
      <  TO_DATE(:DT_FIM,'dd/MM/yyyy') + 1\r

      \t \r

      \ \r

      \r

      \    GROUP BY\r

      \        EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        EXTRACT(DAY FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        'DEVOLUCAO',\r

      \        H.NUM_PEDIDO_VENDA,\r

      \        H.NUM_PEDIDO,\r

      \        H.ID_CENTRO,\r

      \        J.CANAL_VENDA,\r

      \        J.GRUPO_VENDAS,\r

      \        J.ECRITORIO_VENDAS,\r

      \        CAST(H.ID_MATERIAL AS INT),\r

      \        CAST(H.ID_MATERIAL AS INT),\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT),\r

      \        H.NOME_MATERIAL_PEDIDO,\r

      \        H.GRUPO_MERCADORIA,\r

      \        H.MARCA,\r

      \        H.DIVISAO,\r

      \        H.SECAO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO,\r

      \        CAST(H.ID_CLIENTE AS INT),\r

      \        H.NOME_CLIENTE,\r

      \        H.TIPO_PESSOA,\r

      \        TO_CHAR(TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD'), 'DD/MM/YYYY'),\r

      \        H.REGIO,\r

      \        H.NOME_TRANSPORTADOR,\r

      \        J.CONTRIBUINTE_ICMS,\r

      \        J.ID_ATIVIDADE_COMERCIAL,\r

      \tJ.ID_PARCEIRO_INDICACAO,\r

      \tJ.PARCEIRO_INDICACAO\r

      ),\r

      \r

      ESTORNO_DEVOL AS (\r

      \    SELECT  \r

      \        EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      ANO_FATURAMENTO,\r

      \        EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      MES_FATURAMENTO,\r

      \        EXTRACT(DAY FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')) AS
      DIA_FATURAMENTO,\r

      \        'ESTORNO DEVOLUCAO' AS TIPO_NF,\r

      \        H.NUM_PEDIDO_VENDA,\r

      \        H.NUM_PEDIDO AS ORDER_ID,\r

      \        NULL AS NUM_NFE_VENDA,\r

      \        NULL AS REFERENCIA_CLIENTE,\r

      \       \r

      \        H.ID_CENTRO,\r

      \        J.CANAL_VENDA,\r

      \        J.GRUPO_VENDAS,\r

      \        NULL AS ID_ESC_VENDAS,\r

      \        J.ECRITORIO_VENDAS,\r

      \        NULL AS ID_TIPO_DOCUMENTO_PEDIDO,\r

      \        NULL AS ID_VENDEDOR_SALESFORCE,\r

      \        NULL AS PARCEIRO_RECEBEDOR,\r

      \        CASE WHEN J.ID_PARCEIRO_INDICACAO IS NULL THEN NULL ELSE
      CAST(J.ID_PARCEIRO_INDICACAO AS INT) || ' - ' || J.PARCEIRO_INDICACAO END
      PARCEIRO_INDICACAO,\r

      \        CAST(H.ID_MATERIAL AS INT) AS SKU_SAP,\r

      \        CAST(H.ID_MATERIAL AS INT) AS COMPONENTE,\r

      \        CAST(H.ID_MATERIAL AS INT) AS SKU_VTEX,\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT) AS MATERIAL_VTEX,\r

      \        H.NOME_MATERIAL_PEDIDO AS PRODUTO,\r

      \        H.GRUPO_MERCADORIA AS GRUPODEMATERIAL,\r

      \        H.MARCA AS MARCA,\r

      \        NULL AS IMPORTADO,\r

      \        NULL AS DEPARTAMENTO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO AS DEPTO_AJUSTADO,\r

      \        H.DIVISAO AS DIVISÃO,\r

      \        H.SECAO AS SEÇÃO,\r

      \        NULL AS TIPO,\r

      \        CAST(H.ID_CLIENTE AS INT) AS ID_CLIENTE,\r

      \        CAST(H.ID_CLIENTE AS INT) || ' - ' || H.NOME_CLIENTE AS
      NOME_CLIENTE,\r

      \        NULL AS CNPJ,\r

      \        NULL AS CPF,\r

      \        H.TIPO_PESSOA AS TIPOPESSOA,\r

      \        NULL AS TEXTO_CNAE,\r

      \        NULL AS CNAE,\r

      \        NULL AS SEGMENTO_SALESFORCE,\r

      \        TO_CHAR(TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD'), 'DD/MM/YYYY') AS
      DATA_FATURAMENTO,\r

      \        NULL AS PRAZO_MEDIO_OFF,\r

      \        NULL AS ID_FORMA_PAGAMENTO_OFF,\r

      \        H.REGIO AS UF_NF,\r

      \        NULL AS CIDADE,\r

      \        NULL AS CEP,\r

      \        NULL AS CEP_DESTINO_NF,\r

      \        NULL AS ID_DEPOSITO,\r

      \        NULL AS TIPO_FRETE,\r

      \        H.NOME_TRANSPORTADOR AS NOME_TRANSPORTADOR,\r

      \        SUM(NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0))) AS QTD_FATURADA,\r

      \        NULL AS DESCONTO,\r

      \        null AS CTE_LIQUIDO,\r

      \        SUM(NVL(H.VALOR_CTE_LIQUIDO, 0)) as CTE_DEVOL,\r

      \        SUM(CASE WHEN TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD') >= SYSDATE
      - 15  THEN\r

      \            CASE\r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 500 THEN 0.2468 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 1000 THEN 0.1057 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 1500 THEN 0.0607 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 2000 THEN 0.0515 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            WHEN NVL(H.VLTOTAL_NF, 0) < 10000 THEN 0.0391 *
      NVL(H.VLTOTAL_NF, 0) \r

      \            ELSE 0.0165 * NVL(H.VLTOTAL_NF, 0) END ELSE 0 END) \r

      \        AS CTE_PROVISIONADO_DEVOL,\r

      \        NULL AS CTE_PROVISIONADO_FATURADO,\r

      \        NULL AS MARGEM_CONTRIBUICAO_SF,\r

      \        NULL AS MC_SF_ABS,\r

      \        SUM(NVL(H.ICMS_NF, 0)) AS ICMS,\r

      SUM(\r

      \    CASE\r

      \        WHEN J.ID_TIPO_DOCUMENTO_PEDIDO = 'ZGOV'\r

      \             AND NVL(J.CUSTO_NF, 0) = 0\r

      \        THEN\r

      \            NVL(X.CUSTO_MEDIO_ZNOR, 0)\r

      \            * (NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0)))\r

      \r

      \        ELSE\r

      \            (\r

      \                NVL(J.CUSTO_NF, 0)\r

      \                / NULLIF(NVL(J.QTD_FATURADA, 0), 0)\r

      \            ) *\r

      \           (NVL(H.VLTOTAL_NF, 0) / (NULLIF(NVL(J.VLTOTAL_NF, 0), 0) /
      NULLIF(NVL(J.QTD_FATURADA, 0), 0)))\r

      \            \r

      \    END\r

      ) AS CUSTO,       \r

      \        NULL AS CMV_CONTABIL,\r

      \        SUM(NVL(H.ICMS_ST_NF, 0)) AS ICMS_ST,\r

      \        SUM(NVL(H.ICMS_PARTILHA_NF, 0)) AS PARTILHA,\r

      \        SUM(NVL(H.PIS_NF, 0)) AS PIS,\r

      \        SUM(NVL(H.COFINS_NF, 0)) AS COFINS,\r

      \        SUM(NVL(H.ST_FCP_NF, 0)) AS FCP_ST,\r

      \        SUM(NVL(H.FCP_NF, 0)) AS FCP,\r

      \        NULL AS BENEFÍCIOS_AJUSTADO,\r

      \        SUM(NVL(H.ST17_NF, 0)) AS ST17, \r

      \        SUM(NVL(H.DESPESAS_FINANCEIRAS_NF, 0)) AS DESPESAS_FINANCEIRAS,\r

      \        SUM(NVL(H.VL_VENDA_SEM_FRETE, 0)) AS VENDASEMFRETE,\r

      \        NULL AS BASE_ICMS_ST,\r

      \        NULL AS MARGEM_SAP,\r

      \        NULL AS COMISSAO_OFF,\r

      \        SUM(NVL(H.VLTOTAL_NF, 0)) AS VLNOTA,\r

      \        SUM(NVL(H.VLTOTAL_NF, 0) - NVL(H.VL_VENDA_SEM_FRETE, 0)) AS
      FRETE,\r

      \        \r

      \        ----------------------------------\r

      \        -- SUM(NVL(H.BENEFICIOS_FISCAIS_NF, 0)) AS BENEFICIO #####
      REMOVIDO POR INCONSISTENCIA.\r

      \        \r

      \        SUM(CASE \r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2023 AND J.ID_CENTRO IN ('1005','1013','1023','1017')
      THEN  0.0264\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 1 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0281\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0337\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 3 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0274\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 4 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0267\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 5 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0296\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 6 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0212\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 7 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0267\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 8 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0465\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 9 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0349\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 10 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0331\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 11 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0318\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2024 AND EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 12 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0332\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2025 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0185\r

      \            WHEN EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO,
      'YYYYMMDD')) = 2026 AND J.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0196  ELSE 0 END  * H.VLTOTAL_NF -- BENEFICIO FISCAL DRE CANAL / ROB
      CD\r

      \            --WHEN A.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0266\r

      \ \r

      \        ) AS BENEFICIO,\r

      \        -----------------------------------\r

      \        SUM(NVL(H.PIS_NF, 0) + NVL(H.ICMS_NF, 0) + NVL(H.COFINS_NF, 0) +
      NVL(H.ICMS_PARTILHA_NF, 0) + NVL(H.ICMS_ST_NF, 0) + NVL(H.ST_FCP_NF, 0) +
      NVL(H.FCP_NF, 0) + NVL(H.ST17_NF, 0)) AS IMPOSTOS,\r

      \        NULL AS CTE_REAL,\r

      \        NULL AS BONUSSELLOUT,\r

      \        NULL AS PTABELA_SF_AJUSTADO_UNIT,\r

      \t\t\r

      \t\tNULL AS VLDESCONTO_COM_AJUSTE,\r

      \t\t\r

      \t\tNULL AS PTABELA_SF_AJUSTADO_TT,\r

      \t\t\r

      \t\tNULL AS PTABELA_SF_TT,\r

      \t\tNULL AS PTABELA_SF_UNIT,\r

      \t\tNULL AS PERC_DEDUCAO_PTABELA,\r

      \t\tJ.CONTRIBUINTE_ICMS,\r

      \t\tJ.ID_ATIVIDADE_COMERCIAL\r

      \r

      \    FROM FRIOPECASBI.BASE_DEVOLUCAO H\r

      \r

      \r

      \    LEFT JOIN FRIOPECASBI.BASE_VENDAS J\r

      \    ON H.NUM_PEDIDO_VENDA = J.NUM_PEDIDO\r

      \    AND H.ID_MATERIAL = J.ID_MATERIAL_PEDIDO\r

      \r

      \    LEFT JOIN BASEKITS KT\r

      \    ON NVL(H.ID_MATERIAL, 0) = NVL(KT.MATNR_COMP, 0)\r

      \    \r

      \    LEFT JOIN AJUSTE_ZGOV_CENTROS X ON H.ID_MATERIAL =
      X.ID_MATERIAL_PEDIDO AND H.ID_CENTRO = X.ID_CENTRO\r

      \r

      \    WHERE ESTORNO_DEV = 'X'\r

      \    AND(MOTIVO_DEVOLUCAO <> 'GARANTIA' OR MOTIVO_DEVOLUCAO IS NULL)\r

      \    \r

      \    AND TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD') >=
      TO_DATE(:DT_INICIO,'dd/MM/yyyy')\r

      \    AND TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')
      <  TO_DATE(:DT_FIM,'dd/MM/yyyy') + 1\r

      \t \r

      \ \r

      \r

      \    GROUP BY\r

      \        EXTRACT(YEAR FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        EXTRACT(MONTH FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        EXTRACT(DAY FROM TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD')),\r

      \        'ESTORNO DEVOLUCAO',\r

      \        H.NUM_PEDIDO_VENDA,\r

      \        H.NUM_PEDIDO,\r

      \        H.ID_CENTRO,\r

      \        J.CANAL_VENDA,\r

      \        J.GRUPO_VENDAS,\r

      \        J.ECRITORIO_VENDAS,\r

      \        CAST(H.ID_MATERIAL AS INT),\r

      \        CAST(H.ID_MATERIAL AS INT),\r

      \        CAST(KT.MATERIAL_ANTIGO AS INT),\r

      \        H.NOME_MATERIAL_PEDIDO,\r

      \        H.GRUPO_MERCADORIA,\r

      \        H.MARCA,\r

      \        H.DIVISAO,\r

      \        H.SECAO,\r

      \        H.DESCRICAO_DO_DEPARTAMENTO,\r

      \        CAST(H.ID_CLIENTE AS INT),\r

      \        H.NOME_CLIENTE,\r

      \        H.TIPO_PESSOA,\r

      \        TO_CHAR(TO_DATE(H.DATA_FATURAMENTO, 'YYYYMMDD'), 'DD/MM/YYYY'),\r

      \        H.REGIO,\r

      \        H.NOME_TRANSPORTADOR,\r

      \        J.CONTRIBUINTE_ICMS,\r

      \        J.ID_ATIVIDADE_COMERCIAL,\r

      \tJ.ID_PARCEIRO_INDICACAO,\r

      \tJ.PARCEIRO_INDICACAO\r

      ),\r

      \r

      \r

      BASE_COMPLETA AS(\r

      \    SELECT * FROM BASE \r

      UNION ALL\r

      \    SELECT * FROM DEVOL\r

      UNION ALL\r

      \    SELECT * FROM ESTORNO_DEVOL\r

      ),\r

      \r

      VENDAS AS (\r

      SELECT\r

      \    ORDER_ID,\r

      \    ID_SKU,\r

      \    CASE WHEN DATA <= TO_DATE('2024-03-01', 'YYYY-MM-DD') AND DATA >=
      TO_DATE('2024-01-01', 'YYYY-MM-DD') THEN DESCRIVERBAOUTROS ELSE TIPO_VENDA
      END AS TIPO_VENDA,\r

      \    TIPO_OFERTA,\r

      \    ESTIMATE_DELIVERY_DATE,\r

      \    CREATION_DATE,\r

      \    ACAO_PONTUAL,\r

      \    UTMSOURCE,\r

      \    UTMCAMPAIGN,\r

      \    ACQUIRER,\r

      \    SUM(\r

      \        CASE\r

      \            WHEN COD_MKTP = 102 AND DATA <= TO_DATE('2024-05-31',
      'YYYY-MM-DD') THEN -0.0525 * (nvl(SHIPPING_VALUE,0) +
      nvl(SKU_TOTAL_PRICE,0))\r

      \            ELSE nvl(COMISSAO,0)\r

      \        END\r

      \        + nvl(RB,0) + nvl(PR,0) + nvl(PRLJTD,0) + nvl(RBLJTD,0) +
      nvl(COND_CALC_MKTP,0) + nvl(CONDICIONAL_MKTP,0) + nvl(CUPOM_MKTP,0) +
      nvl(FRETE_MKTP,0)\r

      \    ) AS COMISSAO_ON,\r

      \    SUM(COMISSAO) AS COMISSAO_CONTRATO,\r

      \    SUM(RB) AS RB,\r

      \    SUM(PR) AS PR,\r

      \    SUM(RBLJTD) AS RBLJTD,\r

      \    SUM(PRLJTD) AS PRLJTD,\r

      \    SUM(COND_CALC_MKTP) AS COND_CALC_MKTP,\r

      \    SUM(CONDICIONAL_MKTP) AS CONDICIONAL_MKTP,\r

      \    SUM(FRETE_MKTP) AS FRETE_MKTP,\r

      \    sum(CUPOM_MKTP) AS CUPOM_MKTP,\r

      \    SUM(\r

      \        CASE\r

      \            WHEN DATA <= TO_DATE('2024-05-01', 'YYYY-MM-DD') --OR (DATA
      >=  TO_DATE('2024-08-01', 'YYYY-MM-DD'))\r

      \            THEN VLVERBAUTILIZ + VLVERBUTILIZAFRETE\r

      \            ELSE 0\r

      \        END\r

      \    ) AS VERBA_ON,\r

      \    SUM(\r

      \        CASE\r

      \            WHEN DATA >=  TO_DATE('2024-08-01', 'YYYY-MM-DD') AND  DATA
      <=  TO_DATE('2024-08-12', 'YYYY-MM-DD')\r

      \            AND COD_MKTP = 4001\r

      \            THEN VLVERBAUTILIZ\r

      \            \r

      \            WHEN DATA >=  TO_DATE('2024-08-07', 'YYYY-MM-DD') AND  DATA
      <=  TO_DATE('2024-08-12', 'YYYY-MM-DD')\r

      \            AND COD_MKTP = 7430\r

      \            THEN VLVERBAUTILIZ\r

      \ \r

      \            ELSE 0\r

      \        END\r

      \    ) AS VERBA_ADICIONAL,\r

      \    SUM(\r

      \        CASE\r

      \            WHEN DATA >=  TO_DATE('2024-08-01', 'YYYY-MM-DD')\r

      \            THEN VLVERBUTILIZAFRETE\r

      \            ELSE 0\r

      \        END\r

      \    ) AS VERBA_ADICIONAL_FRETE,\r

      \    SUM(SKU_VALUE) AS SKU_VALUE,\r

      \    SUM(SKU_SELLING_PRICE) AS SKU_SELLING_PRICE,\r

      \    SUM(VLVERBUTILIZAFRETE) AS VERBA_FRETE_ON,\r

      \    SUM(SHIPPING_VALUE) AS SHIPPING_VALUE,\r

      \    SUM(SHIPPING_LIST_PRICE) AS SHIPPING_LIST_PRICE,\r

      \    SUM(DICOUNTS_TOTALS) AS DICOUNTS_TOTALS,\r

      \    SUM(CUSTOFRETECALC) AS CUSTO_FRETE_ON\r

      FROM\r

      \    FRIOPECASBI.HIST_VENDAS\r

      \r

      WHERE DATA >= TO_DATE(:DT_INICIO,'dd/MM/yyyy')\r

      \  AND DATA <  TO_DATE(:DT_FIM,'dd/MM/yyyy') + 1\r

      \  \r

      GROUP BY\r

      \    ORDER_ID,\r

      \    ID_SKU,\r

      \    CASE WHEN DATA <= TO_DATE('2024-03-01', 'YYYY-MM-DD') AND DATA >=
      TO_DATE('2024-01-01', 'YYYY-MM-DD') THEN DESCRIVERBAOUTROS ELSE TIPO_VENDA
      END,\r

      \    TIPO_OFERTA,\r

      \    ESTIMATE_DELIVERY_DATE,\r

      \    CREATION_DATE,\r

      \    ACAO_PONTUAL,\r

      \    UTMSOURCE,\r

      \    UTMCAMPAIGN,\r

      \    ACQUIRER\r

      \ \r

      ),\r

      \r

      COMISSAO_AJUSTADA_DIGITAL AS (\r

      \    SELECT\r

      \ \r

      CASE\r

      WHEN COD_MKTP = '102' THEN 'M001'\r

      WHEN COD_MKTP = '7719' THEN 'M004'\r

      WHEN COD_MKTP = '7430' AND SIGLA_MKTP = 'MLB' THEN 'M005'\r

      WHEN COD_MKTP = '7437' THEN 'M006'\r

      WHEN COD_MKTP = '448' THEN 'M007'\r

      WHEN COD_MKTP = '4000' THEN 'M008'\r

      WHEN COD_MKTP = '1478' THEN 'M012'\r

      WHEN COD_MKTP = '4001' THEN 'M013'\r

      WHEN COD_MKTP = '989' THEN 'M014'\r

      WHEN COD_MKTP = '73' THEN 'M015'\r

      WHEN COD_MKTP = '16' THEN 'M016'\r

      WHEN COD_MKTP = '7430' AND SIGLA_MKTP = 'MLC' THEN 'M017'\r

      WHEN COD_MKTP = '10368' THEN 'M018'\r

      WHEN COD_MKTP = '20' THEN 'M020'\r

      WHEN COD_MKTP = '13' THEN 'M021'\r

      WHEN COD_MKTP = '22' THEN 'M022'\r

      WHEN COD_MKTP = '24' THEN 'M024'\r

      WHEN COD_MKTP = '23' THEN 'M023'\r

      WHEN COD_MKTP = '25' THEN 'M026'\r

      ELSE ''\r

      END AS ID_ESC_VENDAS,\r

      MES,\r

      ANO,\r

      \   SUM(\r

      \        CASE\r

      \            WHEN COD_MKTP = 102 AND DATA <= TO_DATE('2024-05-31',
      'YYYY-MM-DD') THEN -0.0525 * (nvl(SHIPPING_VALUE,0) +
      nvl(SKU_TOTAL_PRICE,0))\r

      \            ELSE nvl(COMISSAO,0)\r

      \        END\r

      \        + nvl(RB,0) + nvl(PR,0) + nvl(PRLJTD,0) + nvl(RBLJTD,0) +
      nvl(COND_CALC_MKTP,0) + nvl(CONDICIONAL_MKTP,0) + nvl(CUPOM_MKTP,0) +
      nvl(FRETE_MKTP,0)\r

      \    )\r

      \    / NULLIF(SUM(NVL(SKU_TOTAL_PRICE, 0) + NVL(SHIPPING_VALUE, 0)), 0) AS
      COMISSAO_PERC_AJUSTADA\r

      \ \r

      \ \r

      FROM FRIOPECASBI.HIST_VENDAS\r

      \r

      WHERE DATA >= TO_DATE(:DT_INICIO,'dd/MM/yyyy')\r

      \  AND DATA <  TO_DATE(:DT_FIM,'dd/MM/yyyy') + 1\r

      \ \r

      GROUP BY\r

      CASE\r

      WHEN COD_MKTP = '102' THEN 'M001'\r

      WHEN COD_MKTP = '7719' THEN 'M004'\r

      WHEN COD_MKTP = '7430' AND SIGLA_MKTP = 'MLB' THEN 'M005'\r

      WHEN COD_MKTP = '7437' THEN 'M006'\r

      WHEN COD_MKTP = '448' THEN 'M007'\r

      WHEN COD_MKTP = '4000' THEN 'M008'\r

      WHEN COD_MKTP = '1478' THEN 'M012'\r

      WHEN COD_MKTP = '4001' THEN 'M013'\r

      WHEN COD_MKTP = '989' THEN 'M014'\r

      WHEN COD_MKTP = '73' THEN 'M015'\r

      WHEN COD_MKTP = '16' THEN 'M016'\r

      WHEN COD_MKTP = '7430' AND SIGLA_MKTP = 'MLC' THEN 'M017'\r

      WHEN COD_MKTP = '10368' THEN 'M018'\r

      WHEN COD_MKTP = '20' THEN 'M020'\r

      WHEN COD_MKTP = '13' THEN 'M021'\r

      WHEN COD_MKTP = '22' THEN 'M022'\r

      WHEN COD_MKTP = '24' THEN 'M024'\r

      WHEN COD_MKTP = '23' THEN 'M023'\r

      WHEN COD_MKTP = '25' THEN 'M026'\r

      ELSE ''\r

      END,\r

      MES,\r

      ANO\r

      )\r

      \r

      \r

      SELECT \r

      \    A.ANO_FATURAMENTO,\r

      \    A.MES_FATURAMENTO,\r

      \    A.DIA_FATURAMENTO,\r

      \    A.TIPO_NF,\r

      \    A.NUM_PEDIDO,\r

      \    \r

      \    CASE \r

      \t    WHEN A.PARCEIRO_INDICACAO IS NOT NULL THEN A.ORDER_ID \r

      \    \tWHEN A.ANO_FATURAMENTO = EXTRACT(YEAR FROM SYSDATE) AND
      A.MES_FATURAMENTO = EXTRACT(MONTH FROM SYSDATE) THEN A.ORDER_ID \r

      \    \tELSE NULL \r

      \    END AS ORDER_ID,\r

      \    \r

      \    A.ID_CENTRO,\r

      \    A.ID_ESC_VENDAS,\r

      \        CASE \r

      \        WHEN A.NOME_CLIENTE LIKE '%HISENSE GORENJE%' THEN 'Hisense'\r

      \        WHEN A.ID_TIPO_DOCUMENTO_PEDIDO = 'ZTRA' THEN 'Transportes'\r

      \        WHEN A.ECRITORIO_VENDAS IN ('Administrativo', 'Conde', 'Extrema',
      'Serra') OR A.ECRITORIO_VENDAS IS NULL THEN 'Outros'\r

      \        WHEN A.ID_DEPOSITO = 'MLU' THEN 'Magalu Full'\r

      \        WHEN A.ID_DEPOSITO = 'CBB' THEN 'Cnova Full'\r

      \        ELSE A.ECRITORIO_VENDAS END AS ECRITORIO_VENDAS,\r

      \    A.ID_TIPO_DOCUMENTO_PEDIDO,\r

      \    A.ID_VENDEDOR_SALESFORCE AS ID_VENDEDOR,\r

      \ \r

      \    \r

      \    A.PARCEIRO_INDICACAO,\r

      \    A.SKU_SAP,\r

      \    A.COMPONENTE,\r

      \    A.SKU_VTEX,\r

      \    A.MATERIAL_VTEX,\r

      \    A.ID_CLIENTE,\r

      \    A.CONTRIBUINTE_ICMS,\r

      \    A.NOME_CLIENTE,\r

      \    CASE WHEN A.NOME_CLIENTE LIKE '%HISENSE GORENJE%' THEN 'SIM' ELSE
      'NAO' END AS EXCLUSAO_CLIENTE,\r

      \    A.TIPOPESSOA,\r

      \    A.TEXTO_CNAE,\r

      \    A.CNAE,\r

      \    A.SEGMENTO_SALESFORCE,\r

      \    A.DATA_FATURAMENTO,\r

      \    A.UF_NF,\r

      \    A.CIDADE,\r

      \    A.CEP_DESTINO_NF,\r

      \    A.ID_DEPOSITO,\r

      \    A.TIPO_FRETE,\r

      \    A.NOME_TRANSPORTADOR,\r

      \    A.QTD_FATURADA,\r

      \    A.CTE_LIQUIDO,\r

      \    A.CTE_DEVOL,\r

      \    A.ICMS,\r

      \    A.CUSTO,\r

      \    CASE WHEN A.MARCA IN ('Whirlpool', 'Brastemp', 'Consul', 'Embraco')
      THEN 0.0401 * A.CUSTO ELSE 0 END AS TAXA_VENDOR,\r

      \    A.CMV_CONTABIL,\r

      \    A.ICMS_ST,\r

      \    A.PARTILHA,\r

      \    A.PIS,\r

      \    A.COFINS,\r

      \    A.FCP_ST,\r

      \    A.FCP,\r

      \    A.ST17,\r

      \    A.VENDASEMFRETE,\r

      \    A.BASE_ICMS_ST,\r

      \    A.MARGEM_SAP,\r

      \    A.COMISSAO_OFF,\r

      \    A.VLNOTA,\r

      \    A.FRETE,\r

      \    A.BENEFICIO,\r

      \    A.IMPOSTOS,\r

      \    A.CTE_REAL,\r

      \    A.CTE_PROVISIONADO_DEVOL,\r

      \    A.CTE_PROVISIONADO_FATURADO, \r

      \    \r

      \    B.ACAO_PONTUAL,\r

      \    B.UTMSOURCE,\r

      \    B.UTMCAMPAIGN,\r

      \    G.COMISSAO_PERC_AJUSTADA,\r

      \r

      ----- AJUSTE CONSIDERANDO APENAS OS CENTROS\r

      \    SUM(CASE \r

      \            WHEN A.ANO_FATURAMENTO = 2023 AND A.ID_CENTRO IN
      ('1005','1013','1023','1017') THEN  0.0264\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 1 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0281\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 2 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0337\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 3 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0274\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 4 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0267\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 5 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0296\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 6 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0212\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 7 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0267\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 8 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0465\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 9 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0349\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 10 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0331\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 11 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0318\r

      \            WHEN A.ANO_FATURAMENTO = 2024 AND A.MES_FATURAMENTO = 12 AND
      A.ID_CENTRO IN ('1005','1013','1023','1017') THEN 0.0332\r

      \            WHEN A.ANO_FATURAMENTO = 2025 AND A.ID_CENTRO IN
      ('1005','1013','1023','1017') THEN 0.0185\r

      \            WHEN A.ANO_FATURAMENTO = 2026 AND A.ID_CENTRO IN
      ('1005','1013','1023','1017') THEN 0.0196  ELSE 0 END * A.VLNOTA --
      BENEFICIO FISCAL DRE CANAL / ROB CD\r

      \            --WHEN A.ID_CENTRO IN ('1005','1013','1023','1017') THEN
      0.0266\r

      \ \r

      \        ) AS BENEFICIO_CALC,\r

      ----- AJUSTE CONSIDERANDO APENAS OS CENTROS\r

      \r

      \    SUM(CASE WHEN A.TIPO_NF = 'FATURAMENTO' THEN A.VLNOTA ELSE 0 END) AS
      VALOR_FATURADO,\r

      \    SUM(CASE WHEN (A.TIPO_NF = 'DEVOLUCAO' OR A.TIPO_NF = 'ESTORNO
      DEVOLUCAO') THEN (CASE WHEN A.VLNOTA > 1000000 THEN 0 ELSE A.VLNOTA END)
      ELSE 0 END) AS VALOR_DEVOLVIDO,\r

      \    SUM(CASE WHEN (A.TIPO_NF = 'DEVOLUCAO' OR A.TIPO_NF = 'ESTORNO
      DEVOLUCAO') THEN A.CTE_LIQUIDO + A.CTE_PROVISIONADO_DEVOL ELSE 0 END) AS
      CTE_DEVOLVIDO,\r

      \    SUM(CASE WHEN A.TIPO_NF = 'FATURAMENTO' THEN A.CTE_LIQUIDO +
      A.CTE_PROVISIONADO_FATURADO ELSE 0 END) AS CTE_FATURADO,\r

      \    SUM(B.VERBA_ON) AS VERBA_ON,\r

      \    SUM(B.VERBA_ADICIONAL) AS VERBA_ADICIONAL,\r

      \    SUM(B.VERBA_ADICIONAL_FRETE) AS VERBA_ADICIONAL_FRETE,\r

      \    SUM(B.COMISSAO_ON) AS COMISSAO_ON,\r

      \    SUM(B.VERBA_FRETE_ON) AS VERBA_FRETE_ON,\r

      \    SUM(B.SHIPPING_VALUE) AS SHIPPING_VALUE,\r

      \    SUM(B.SHIPPING_LIST_PRICE) AS SHIPPING_LIST_PRICE,\r

      \    SUM(B.DICOUNTS_TOTALS) AS DISCOUNTS_TOTALS,\r

      \    SUM(B.SKU_VALUE) AS SKU_VALUE,\r

      \    SUM(B.SKU_SELLING_PRICE) AS SKU_SELLING_PRICE,\r

      \    SUM(BONUSSELLOUT) AS BONUSSELLOUT,\r

      \    SUM(B.COMISSAO_CONTRATO) AS COMISSAO_CONTRATO,\r

      \    SUM(B.RB) AS RB,\r

      \    SUM(B.PR) AS PR,\r

      \    SUM(B.RBLJTD) AS RBLJTD,\r

      \    SUM(B.PRLJTD) AS PRLJTD,\r

      \    SUM(B.COND_CALC_MKTP) AS COND_CALC_MKTP,\r

      \    SUM(B.CONDICIONAL_MKTP) AS CONDICIONAL_MKTP,\r

      \    SUM(B.FRETE_MKTP) AS FRETE_MKTP,\r

      \    \r

      \    A.PTABELA_SF_AJUSTADO_UNIT,\r

      \t\t\r

      \tA.VLDESCONTO_COM_AJUSTE,\r

      \t\t\r

      \tA.PTABELA_SF_AJUSTADO_TT,\r

      \tA.MARGEM_CONTRIBUICAO_SF,\r

      \tA.MC_SF_ABS,\r

      \tA.PTABELA_SF_TT,\r

      \tA.PTABELA_SF_UNIT,\r

      \tA.PERC_DEDUCAO_PTABELA,\r

      \tA.ID_ATIVIDADE_COMERCIAL\r

      \r

      \r

      FROM BASE_COMPLETA A\r

      \r

      LEFT JOIN VENDAS B\r

      ON (CASE WHEN A.ID_DEPOSITO = 'MLU' THEN 'LU-' ||
      SUBSTR(A.REFERENCIA_CLIENTE, 1, 16) ELSE A.REFERENCIA_CLIENTE END)  =
      B.ORDER_ID AND CASE WHEN A.MATERIAL_VTEX IS NULL THEN A.SKU_VTEX ELSE
      A.MATERIAL_VTEX END = B.ID_SKU\r

      \r

      LEFT JOIN COMISSAO_AJUSTADA_DIGITAL G\r

      ON A.ANO_FATURAMENTO = G.ANO AND \r

      \    A.MES_FATURAMENTO = G.MES AND \r

      \    A.ID_ESC_VENDAS = G.ID_ESC_VENDAS\r

      \r

      \   \r

      \  \r

      \r

      GROUP BY\r

      \r

      \    A.ANO_FATURAMENTO,\r

      \    A.MES_FATURAMENTO,\r

      \    A.DIA_FATURAMENTO,\r

      \    A.TIPO_NF,\r

      \    A.NUM_PEDIDO,\r

      \    \r

      \    CASE \r

      \t    WHEN A.PARCEIRO_INDICACAO IS NOT NULL THEN A.ORDER_ID \r

      \    \tWHEN A.ANO_FATURAMENTO = EXTRACT(YEAR FROM SYSDATE) AND
      A.MES_FATURAMENTO = EXTRACT(MONTH FROM SYSDATE) THEN A.ORDER_ID \r

      \    \tELSE NULL \r

      \    END,\r

      \    \r

      \    \r

      \    A.ID_CENTRO,\r

      \    A.ID_ESC_VENDAS,\r

      \   CASE \r

      \        WHEN A.NOME_CLIENTE LIKE '%HISENSE GORENJE%' THEN 'Hisense'\r

      \        WHEN A.ID_TIPO_DOCUMENTO_PEDIDO = 'ZTRA' THEN 'Transportes'\r

      \        WHEN A.ECRITORIO_VENDAS IN ('Administrativo', 'Conde', 'Extrema',
      'Serra') OR A.ECRITORIO_VENDAS IS NULL THEN 'Outros'\r

      \        WHEN A.ID_DEPOSITO = 'MLU' THEN 'Magalu Full'\r

      \        WHEN A.ID_DEPOSITO = 'CBB' THEN 'Cnova Full'\r

      \        ELSE A.ECRITORIO_VENDAS END,\r

      \    A.ID_TIPO_DOCUMENTO_PEDIDO,\r

      \    A.ID_VENDEDOR_SALESFORCE,\r

      \    \r

      \    A.PARCEIRO_INDICACAO,\r

      \    A.SKU_SAP,\r

      \    A.COMPONENTE,\r

      \    A.SKU_VTEX,\r

      \    A.MATERIAL_VTEX,\r

      \    A.ID_CLIENTE,\r

      \    A.NOME_CLIENTE,\r

      \    A.CONTRIBUINTE_ICMS,\r

      \    CASE WHEN A.NOME_CLIENTE LIKE '%HISENSE GORENJE%' THEN 'SIM' ELSE
      'NAO' END,\r

      \    A.TIPOPESSOA,\r

      \    A.TEXTO_CNAE,\r

      \    A.CNAE,\r

      \    A.SEGMENTO_SALESFORCE,\r

      \    A.DATA_FATURAMENTO,\r

      \    A.UF_NF,\r

      \    A.CIDADE,\r

      \    A.CEP_DESTINO_NF,\r

      \    A.ID_DEPOSITO,\r

      \    A.TIPO_FRETE,\r

      \    A.NOME_TRANSPORTADOR,\r

      \    A.QTD_FATURADA,\r

      \    A.CTE_LIQUIDO,\r

      \    A.CTE_DEVOL,\r

      \    A.ICMS,\r

      \    A.CUSTO,\r

      \      \r

      \ \r

      \    CASE WHEN A.MARCA IN ('Whirlpool', 'Brastemp', 'Consul', 'Embraco')
      THEN 0.0401 * A.CUSTO ELSE 0 END,\r

      \    A.CMV_CONTABIL,\r

      \    A.ICMS_ST,\r

      \    A.PARTILHA,\r

      \    A.PIS,\r

      \    A.COFINS,\r

      \    A.FCP_ST,\r

      \    A.FCP,\r

      \    A.ST17,\r

      \    A.VENDASEMFRETE,\r

      \    A.BASE_ICMS_ST,\r

      \    A.MARGEM_SAP,\r

      \    A.COMISSAO_OFF,\r

      \    A.VLNOTA,\r

      \    A.FRETE,\r

      \    A.BENEFICIO,\r

      \    A.IMPOSTOS,\r

      \    A.CTE_REAL,\r

      \    A.CTE_PROVISIONADO_DEVOL,\r

      \    A.CTE_PROVISIONADO_FATURADO,\r

      \    B.ACAO_PONTUAL,\r

      \    A.MARGEM_CONTRIBUICAO_SF,\r

      \    A.MC_SF_ABS,\r

      \    B.UTMSOURCE,\r

      \    B.UTMCAMPAIGN,\r

      \    G.COMISSAO_PERC_AJUSTADA,\r

      \    A.PTABELA_SF_AJUSTADO_UNIT,\r

      \t\r

      \tA.VLDESCONTO_COM_AJUSTE,\r

      \t\t\r

      \tA.PTABELA_SF_AJUSTADO_TT,\r

      \t\t\r

      \tA.PTABELA_SF_TT,\r

      \tA.PTABELA_SF_UNIT,\r

      \tA.PERC_DEDUCAO_PTABELA,\r

      \tA.ID_ATIVIDADE_COMERCIAL;"
    languageId: oracle-sql
