	partition Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2020,1,1), DATE(2030,12,31)),
				    
				    "Ano", YEAR([Date]),
				    "Mês Número", MONTH([Date]),
				    -- Forçando pt-BR no nome do mês
				    "Mês Nome", FORMAT([Date], "MMMM", "pt-BR"),
				    "Mês Nome Caixa Alta", UPPER(FORMAT([Date], "MMMM", "pt-BR")),
				    
				    -- Nova coluna concatenada: "1. JANEIRO", "2. FEVEREIRO", etc.
				    "Mês Índice Nome", 
				        COMBINEVALUES(". ", 
				            FORMAT(MONTH([Date]), "0"), 
				            UPPER(FORMAT([Date], "MMMM", "pt-BR"))
				        ),
				
				    "Mês Abrev", FORMAT([Date], "MMM", "pt-BR"),
				    "Ano-Mês", FORMAT([Date], "YYYY-MM"),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "Semana do Ano", WEEKNUM([Date]),
				    "Dia", DAY([Date]),
				    "Dia da Semana Num", WEEKDAY([Date], 2),
				    -- Forçando pt-BR no dia da semana
				    "Dia da Semana", FORMAT([Date], "dddd", "pt-BR"),
				    "Dia Útil", IF(WEEKDAY([Date], 2) <= 5, "Sim", "Não"),
				    "Ordem Mês", MONTH([Date])
				)
				```

	annotation PBI_Id = 13ab1f9482494fda961da77365418c79

